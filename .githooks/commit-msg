#!/bin/sh
# Cada commit identifica su tarea de Jira en la primera linea y su historia al final del cuerpo, para
# rastrear cada cambio en `git log --oneline`, en GitHub y en Jira (app GitHub for Jira):
#
#     fix(documents): AS2-86 nombre binario de FileRef en la consulta de consistencia
#
#     Detalle del cambio.
#
#     Refs: HU-14 (AS2-14)
#
# En la primera linea va la clave mas especifica (subtarea o tarea); una tarea sin historia repite su
# clave en el pie (`Refs: AS2-91`). No se exige en los commits de fusion ni en las ramas release/* y
# hotfix/* (commits de version). El CI aplica la misma regla a cada pull request
# (.github/scripts/check_commit_refs.sh).
#
# Activar en tu clon (una sola vez):   git config core.hooksPath .githooks
# Excepcion puntual:                   git commit --no-verify

msg_file="$1"
git_dir=$(git rev-parse --git-dir)

[ -f "$git_dir/MERGE_HEAD" ] && exit 0
branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null)
case "$branch" in
    release/* | hotfix/*) exit 0 ;;
esac

. "$(git rev-parse --show-toplevel)/.github/scripts/commit_rules.sh"
if problema=$(commit_problema "$msg_file"); then
    exit 0
fi

echo "-----------------------------------------------------------"
echo "commit-msg: $problema"
echo "Formato:"
echo ""
echo "    fix(documents): AS2-86 nombre binario de FileRef"
echo ""
echo "    Refs: HU-14 (AS2-14)"
echo "-----------------------------------------------------------"
exit 1
