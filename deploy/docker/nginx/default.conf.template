# Proxy TLS de la plataforma: unico punto publicado. Sirve la consola y reenvia el API al gateway,
# que no se publica fuera de la red de contenedores.

# HTTP: solo redirige a HTTPS.
server {
    listen 80;
    server_name _;
    server_tokens off;
    return 301 https://$host:${PUBLIC_HTTPS_PORT}$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${SERVER_NAME};
    server_tokens off;

    ssl_certificate     /etc/nginx/certs/tls.crt;
    ssl_certificate_key /etc/nginx/certs/tls.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;

    # Mensajes AS2 grandes: los socios envian lotes de documentos.
    client_max_body_size 50m;

    include /etc/nginx/snippets/security-headers.conf;

    # ---- API y sesion -> gateway ----
    location /api/ {
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://gateway:8765;
    }
    location /auth/ {
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://gateway:8765;
    }
    # /users sin barra final tambien es del API (listado de usuarios).
    location /users {
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://gateway:8765;
    }
    location /.well-known/ {
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://gateway:8765;
    }

    # ---- Socios AS2 (se autentican con S/MIME) ----
    location = /as2/receive {
        include /etc/nginx/snippets/proxy.conf;
        proxy_request_buffering off;
        proxy_pass http://gateway:8765;
    }
    location = /internal/as2/mdn-callback {
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://gateway:8765;
    }

    # ---- Consola (SPA) ----
    root /usr/share/nginx/html;
    location / {
        try_files $uri $uri/ /index.html;
    }
    location = /index.html {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }
    location = /config.js {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
}
