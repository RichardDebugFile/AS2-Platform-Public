# syntax=docker/dockerfile:1
# Consola web servida por nginx, que ademas es el proxy TLS de toda la plataforma.

# ---------- Etapa 1: compilacion de la SPA ----------
FROM node:22-alpine AS build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npm run build

# ---------- Etapa 2: nginx ----------
FROM nginx:1.29-alpine
# curl para el healthcheck por HTTPS (el wget de busybox depende de ssl_client).
RUN apk add --no-cache curl
COPY --from=build /app/dist /usr/share/nginx/html
# Consola y API en el mismo origen: config.js apunta al propio proxy.
COPY deploy/docker/nginx/config.js /usr/share/nginx/html/config.js
# La imagen de nginx sustituye las variables de entorno en templates/*.template al arrancar.
COPY deploy/docker/nginx/default.conf.template /etc/nginx/templates/default.conf.template
COPY deploy/docker/nginx/proxy.conf deploy/docker/nginx/security-headers.conf /etc/nginx/snippets/
EXPOSE 80 443
