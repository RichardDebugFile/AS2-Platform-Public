{
  "info": {
    "name": "partners-service",
    "description": "Socios comerciales y su configuración AS2 (HU-08). Contra el stack Docker: host = https://localhost y ejecutar primero la carpeta \"Sesión (vía gateway)\" (Postman guarda las cookies). Contra el servicio en local (sin gateway): host = http://localhost:8081 y omitir esa carpeta. La colección deja la base como estaba: borra los socios que crea.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "host",
      "value": "https://localhost"
    },
    {
      "key": "adminUser",
      "value": "admin"
    },
    {
      "key": "adminPassword",
      "value": ""
    },
    {
      "key": "as2Name",
      "value": "SOCIO-POSTMAN"
    },
    {
      "key": "as2NameInternal",
      "value": "SOCIO-POSTMAN-INTERNO"
    },
    {
      "key": "partnerId",
      "value": ""
    },
    {
      "key": "internalId",
      "value": ""
    },
    {
      "key": "xsrfToken",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!['GET', 'HEAD', 'OPTIONS'].includes(pm.request.method)) {",
          "  pm.request.headers.upsert({ key: 'X-XSRF-TOKEN', value: pm.collectionVariables.get('xsrfToken') || '' });",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const xsrf = pm.cookies.get('XSRF-TOKEN');",
          "if (xsrf) pm.collectionVariables.set('xsrfToken', xsrf);"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Sesión (vía gateway)",
      "description": "Solo contra el stack completo (host = https://localhost). Sin esta carpeta, el gateway responde 401.",
      "item": [
        {
          "name": "Token CSRF",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{host}}/.well-known/jwks.json",
              "host": [
                "{{host}}"
              ],
              "path": [
                ".well-known",
                "jwks.json"
              ]
            },
            "description": "Obtiene la cookie XSRF-TOKEN; las peticiones que modifican la reenvían en X-XSRF-TOKEN."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('cookie XSRF-TOKEN', () => pm.expect(pm.cookies.has('XSRF-TOKEN')).to.be.true);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{host}}/auth/login",
              "host": [
                "{{host}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{adminUser}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "description": "La contraseña del administrador está en deploy/docker/.env (ADMIN_PASSWORD)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('cookie de sesión', () => pm.expect(pm.cookies.has('access_token')).to.be.true);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Socios",
      "item": [
        {
          "name": "Catálogo de algoritmos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{host}}/api/catalogs/algorithms",
              "host": [
                "{{host}}"
              ],
              "path": [
                "api",
                "catalogs",
                "algorithms"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const c = pm.response.json();",
                  "pm.test('SHA-256 recomendado', () => pm.expect(c.signing.find(i => i.status === 'recommended').key).to.eql('RSA_SHA256'));",
                  "pm.test('SHA-1 solo por compatibilidad', () => pm.expect(c.signing.find(i => i.key === 'RSA_SHA1').status).to.eql('legacy'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Alta completa",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{host}}/api/partners/complete",
              "host": [
                "{{host}}"
              ],
              "path": [
                "api",
                "partners",
                "complete"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"partner\": {\n    \"as2Name\": \"{{as2Name}}\",\n    \"partnerName\": \"Socio de prueba\",\n    \"partnerType\": \"CUSTOMER\",\n    \"serverAddress\": \"as2.socio.example\",\n    \"port\": 4443,\n    \"transportType\": \"HTTPS\",\n    \"path\": \"/as2\",\n    \"signingAlgorithm\": \"RSA_SHA256\",\n    \"encryptionAlgorithm\": \"AES256\",\n    \"micAlgorithm\": \"SHA256\",\n    \"basicAuthUsername\": \"usuario\",\n    \"basicAuthPassword\": \"secreto-de-prueba\",\n    \"contactEmail\": \"ops@example.com\"\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "const r = pm.response.json();",
                  "pm.collectionVariables.set('partnerId', r.partner.id);",
                  "pm.test('activo con sus tres configuraciones', () => { pm.expect(r.partner.active).to.be.true; pm.expect(r.outgoing).to.be.an('object'); pm.expect(r.incoming).to.be.an('object'); pm.expect(r.mdn).to.be.an('object'); });",
                  "pm.test('la clave básica no sale', () => { pm.expect(r.partner).to.not.have.property('basicAuthPassword'); pm.expect(r.partner.hasBasicAuthPassword).to.be.true; });",
                  "pm.test('dirección AS2', () => pm.expect(r.partner.endpointUrl).to.eql('https://as2.socio.example:4443/as2'));"
                ]
              }
            }
          ]
        },
