root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{ts,tsx,js,jsx,json,css,html,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Los .bat DEBEN usar CRLF o cmd.exe falla
[*.{bat,cmd}]
end_of_line = crlf
