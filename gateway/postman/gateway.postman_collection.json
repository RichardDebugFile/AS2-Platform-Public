    {
      "name": "Sesión (vía gateway)",
      "item": [
        {
          "name": "Token CSRF",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{host}}/.well-known/jwks.json",
              "host": [
                "{{host}}"
              ],
              "path": [
                ".well-known",
                "jwks.json"
              ]
            },
            "description": "Obtiene la cookie XSRF-TOKEN; las peticiones que modifican la reenvían en X-XSRF-TOKEN."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('cookie XSRF-TOKEN', () => pm.expect(pm.cookies.has('XSRF-TOKEN')).to.be.true);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{host}}/auth/login",
              "host": [
                "{{host}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{adminUser}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "description": "La contraseña del administrador está en deploy/docker/.env (ADMIN_PASSWORD)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('cookie de sesión', () => pm.expect(pm.cookies.has('access_token')).to.be.true);"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear usuario auditor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{host}}/users",
              "host": [
                "{{host}}"
              ],
              "path": [
                "users"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{auditorUser}}\",\n  \"password\": \"{{auditorPassword}}\",\n  \"email\": \"{{auditorUser}}@example.com\",\n  \"roles\": [\n    \"AUDITOR\"\n  ],\n  \"active\": true\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Sin credenciales fijas en el repositorio: usuario y contrasena aleatorios por corrida.",
                  "pm.collectionVariables.set('auditorUser', 'auditor-gw-' + Date.now());",
                  "const abc = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789';",
                  "let s = '';",
                  "for (let i = 0; i < 24; i++) s += abc[Math.floor(Math.random() * abc.length)];",
                  "pm.collectionVariables.set('auditorPassword', s + '#1');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "const u = pm.response.json();",
                  "pm.collectionVariables.set('auditorId', u.id);",
                  "pm.test('rol AUDITOR', () => pm.expect(u.roles).to.eql(['AUDITOR']));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Salud",
      "item": [
        {
          "name": "Estado del sistema",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{host}}/api/system/status",
              "host": [
                "{{host}}"
              ],
              "path": [
                "api",
                "system",
                "status"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "const s = Object.fromEntries(r.services.map(x => [x.service, x]));",
                  "pm.test('revisado ahora', () => pm.expect(Date.parse(r.checkedAt)).to.be.above(Date.now() - 60000));",
                  "pm.test('gateway en línea', () => pm.expect(s.gateway.status).to.eql('UP'));",
                  "['partners-service', 'auth-service', 'documents-service'].forEach(n => {",
                  "  pm.test(n + ' en línea con su base de datos', () => {",
                  "    pm.expect(s[n].status).to.eql('UP');",
                  "    pm.expect(s[n].latencyMs).to.be.a('number');",
                  "    pm.expect(s[n].components.db).to.eql('UP');",
                  "  });",
                  "});",
                  "pm.test('as2-adapter en línea', () => pm.expect(s['as2-adapter'].status).to.eql('UP'));",
                  "pm.test('sin detalles internos', () => r.services.forEach(x => Object.values(x.components || {}).forEach(v => pm.expect(v).to.be.a('string'))));"
                ]
              }
            }
          ]
        }
      ]
    },
