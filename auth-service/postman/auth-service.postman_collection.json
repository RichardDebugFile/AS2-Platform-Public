        {
          "name": "Código erróneo (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{host}}/auth/mfa/verify",
              "host": [
                "{{host}}"
              ],
              "path": [
                "auth",
                "mfa",
                "verify"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mfaToken\": \"{{mfaToken}}\",\n  \"code\": \"{{wrongCode}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// TOTP de la RFC 6238 (HMAC-SHA1, 6 digitos, pasos de 30 s), como la app autenticadora.",
                  "function base32ToHex(b32) {",
                  "  const a = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ234567';",
                  "  let bits = '';",
                  "  for (const c of b32.replace(/=+$/, '').toUpperCase()) {",
                  "    const v = a.indexOf(c);",
                  "    if (v >= 0) bits += v.toString(2).padStart(5, '0');",
                  "  }",
                  "  let hex = '';",
                  "  for (let i = 0; i + 8 <= bits.length; i += 8) hex += parseInt(bits.substr(i, 8), 2).toString(16).padStart(2, '0');",
                  "  return hex;",
                  "}",
                  "function totp(secret) {",
                  "  const CryptoJS = require('crypto-js');",
                  "  const step = Math.floor(Date.now() / 1000 / 30);",
                  "  const counter = step.toString(16).padStart(16, '0');",
                  "  const h = CryptoJS.HmacSHA1(CryptoJS.enc.Hex.parse(counter), CryptoJS.enc.Hex.parse(base32ToHex(secret))).toString(CryptoJS.enc.Hex);",
                  "  const o = parseInt(h.substr(h.length - 1), 16);",
                  "  const bin = parseInt(h.substr(o * 2, 8), 16) & 0x7fffffff;",
                  "  return String(bin % 1000000).padStart(6, '0');",
                  "}",
                  "// Un codigo distinto del vigente y de los pasos vecinos.",
                  "const ok = totp(pm.collectionVariables.get('totpSecret'));",
                  "pm.variables.set('wrongCode', String((Number(ok) + 500000) % 1000000).padStart(6, '0'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 401', () => pm.response.to.have.status(401));",
                  "pm.test('MFA_INVALID_CODE', () => pm.expect(pm.response.json().code).to.eql('MFA_INVALID_CODE'));"
                ]
