        {
          "name": "Crear usuario de prueba",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{host}}/users",
              "host": [
                "{{host}}"
              ],
              "path": [
                "users"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{testUser}}\",\n  \"password\": \"{{testPassword}}\",\n  \"email\": \"{{testUser}}@example.com\",\n  \"roles\": [\n    \"OPERATOR\"\n  ],\n  \"active\": true\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Sin credenciales fijas en el repositorio: usuario y contrasena aleatorios por corrida.",
                  "pm.collectionVariables.set('testUser', 'postman-auth-' + Date.now());",
                  "const abc = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789';",
                  "let s = '';",
                  "for (let i = 0; i < 24; i++) s += abc[Math.floor(Math.random() * abc.length)];",
                  "pm.collectionVariables.set('testPassword', s + '#1');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "const u = pm.response.json();",
                  "pm.collectionVariables.set('testUserId', u.id);",
                  "pm.test('rol OPERATOR', () => pm.expect(u.roles).to.eql(['OPERATOR']));"
                ]
              }
            }
          ]
        },
