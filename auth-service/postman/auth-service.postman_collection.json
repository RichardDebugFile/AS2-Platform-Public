        {
          "name": "Generar secreto (QR)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{host}}/users/me/mfa/setup",
              "host": [
                "{{host}}"
              ],
              "path": [
                "users",
                "me",
                "mfa",
                "setup"
